# Copy this file to .env.local (which is gitignored) and fill in your values.

# Anthropic API key. Required for the newsletter agent (npm run newsletter).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Restart `npm run dev` after editing — env vars only load on server start.

# Google AI Studio API key. Get one at https://aistudio.google.com/apikey.
# Image generation requires the paid tier (~$0.039 per image with
# gemini-2.5-flash-image). This stays server-side via the Vite dev proxy
# and never enters the browser bundle.
GEMINI_API_KEY=

# Set to "true" to opt in to real image editing. When false (or unset),
# the app uses the on-device CSS-filter stand-in instead.
VITE_USE_REAL_GENERATION=false

# Optional: override the editing model. Defaults to gemini-2.5-flash-image
# (a.k.a. "nano-banana"), the right tool for instruction-based haircut edits
# while preserving identity.
# VITE_GEMINI_MODEL=gemini-2.5-flash-image
