# Copy this file to .env.local (which is gitignored) and fill in your values.
# Restart `npm run dev` after editing.

# Replicate API token. Get one at https://replicate.com/account/api-tokens.
# This stays server-side via the Vite dev proxy and never enters the browser.
REPLICATE_API_TOKEN=

# Set to "true" to opt in to real image editing. When false (or unset),
# the app uses the on-device CSS-filter stand-in instead.
VITE_USE_REAL_GENERATION=false

# Optional: override the editing model. Defaults to FLUX Kontext Pro, which is
# the right tool for instruction-based haircut edits ("give the dog a mohawk")
# while preserving identity. Cheaper alternatives: black-forest-labs/flux-kontext-dev.
# VITE_REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
