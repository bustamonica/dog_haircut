# Copy this file to .env.local (which is gitignored) and fill in your values.
# Restart `npm run dev` after editing.

# Replicate API token. Get one at https://replicate.com/account/api-tokens.
# This stays server-side via the Vite dev proxy and never enters the browser.
REPLICATE_API_TOKEN=

# Set to "true" to opt in to real img2img generation. When false (or unset),
# the app uses the on-device CSS-filter stand-in instead.
VITE_USE_REAL_GENERATION=false
